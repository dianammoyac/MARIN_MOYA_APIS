DJANGO_DEBUG=1
DJANGO_SECRET_KEY=cambia-esta-clave-en-cada-entorno
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,raizenta.com,www.raizenta.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://raizenta.com,https://www.raizenta.com
# DJANGO_STATIC_ROOT=staticfiles (por defecto usa la carpeta staticfiles del proyecto)
# Solo desarrollo/pruebas locales sin MySQL:
DJANGO_USE_SQLITE=0
# Si se usa SQLite, puede indicarse un archivo local de desarrollo distinto:
# DJANGO_SQLITE_NAME=C:/ruta/local/perfilador_desarrollo.sqlite3
DB_NAME=bd_marinmoya_inversiones
DB_USER=root
DB_PASSWORD=cambia-esta-contrasena
MYSQL_ROOT_PASSWORD=cambia-tambien-esta-contrasena
DB_HOST=db
DB_PORT=3306
PERFILADOR_LIMITE_CREAR=20
PERFILADOR_LIMITE_EVALUAR=60
PERFILADOR_LIMITE_SIMULAR=60
PERFILADOR_LIMITE_SOLICITAR=10
